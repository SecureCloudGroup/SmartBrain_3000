    "@types/qrcode": "^1.5.6",
    "jsdom": "^30.0.1",
    "lucide": "^1.28.0",
    "marked": "^18.0.7",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.6.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@noble/ed25519": "^3.1.0",

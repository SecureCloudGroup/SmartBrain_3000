    "marked": "^18.1.3",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.6.0",
    "vite": "^8.3.6",
    "vitest": "^4.1.12"
  },
  "dependencies": {
